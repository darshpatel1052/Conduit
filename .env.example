# Copy to .env for host-local development. The default Compose stack already
# supplies development-only infrastructure values so `docker compose up` works
# without this file.

# Required outside the development Compose defaults. Generate once with:
#   openssl rand -base64 32
# Changing this value without re-encrypting provider credentials makes them
# unreadable, so store it with the same care as database credentials.
CONDUIT_MASTER_KEY=

# --- Gateway overrides (win over configs/conduit.yaml) ---------------------
# CONDUIT_ADDR=:8080
# CONDUIT_LOG_LEVEL=debug
# CONDUIT_LOG_FORMAT=text
# CONDUIT_ROUTES_FILE=configs/routes.yaml

# All three stores are part of the product, not optional add-ons.
REDIS_URL=redis://localhost:6379/0
POSTGRES_DSN=postgres://conduit:conduit@localhost:5432/conduit?sslmode=disable
CLICKHOUSE_DSN=clickhouse://conduit:conduit@localhost:9000/conduit

# Provider credentials are added per project through the control plane. They
# are encrypted before PostgreSQL persistence and do not belong in this file.
